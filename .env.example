# APP_URL: Public URL where the app is hosted.
APP_URL="https://fernanda-rabelo-psicologia-online.ai.studio"

# Supabase Auth - safe public browser configuration.
NEXT_PUBLIC_SUPABASE_URL="https://oqudtwtnnuqgvltcremx.supabase.co"
