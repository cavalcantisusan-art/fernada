# GEMINI_API_KEY: Required only when Gemini features are enabled.
# AI Studio can inject this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted.
APP_URL="https://fernanda-rabelo-psicologia-online.ai.studio"

# Supabase Auth - safe public browser configuration.
NEXT_PUBLIC_SUPABASE_URL="https://oqudtwtnnuqgvltcremx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_SOOwgewRCvOCvpHR4sKECw_d7leAlav"

# Supabase booking database/server operations.
# SUPABASE_SERVICE_ROLE_KEY is server-only. Never expose it in NEXT_PUBLIC_* variables.
SUPABASE_URL="https://oqudtwtnnuqgvltcremx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# Stripe Checkout (server-only secrets).
# Use test keys first. Never prefix these variables with NEXT_PUBLIC_.
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SIGNING_SECRET"

# Optional transactional email via Resend.
# If omitted, payment confirmation still works; only the email is skipped.
